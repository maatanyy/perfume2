# Flask
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development

# Database
DATABASE_URL=sqlite:///crawling.db

# Google Sheets API (선택사항)
GOOGLE_API_KEY=your-google-api-key

# 크롤링 설정 (8GB RAM, 4 vCPU 서버 기준)
MAX_CONCURRENT_JOBS_PER_USER=5
MAX_CONCURRENT_JOBS_SYSTEM=10
CRAWLING_MAX_WORKERS=5
BROWSER_POOL_MAX_BROWSERS=5
MEMORY_WARNING_THRESHOLD_MB=5500
MEMORY_CRITICAL_THRESHOLD_MB=7000

# SSG 프록시 (선택) — 데이터센터 IP가 봇 차단에 걸릴 때 주거용 프록시 경유
# 설정 시 브라우저 워밍업과 HTTP 수집 모두 이 프록시를 사용한다
# SSG_PROXY=http://user:password@proxy.example.com:8080
